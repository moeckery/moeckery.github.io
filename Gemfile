source "https://rubygems.org"

# Matches the versions GitHub Pages builds with, so a local preview and the
# deployed site can't drift apart.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Not in the default gemset on newer Rubies.
gem "webrick", "~> 1.8"
